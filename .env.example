# Энэ файлыг ".env" нэрээр хуулаад жинхэнэ утгаа зөвхөн .env-д бичнэ.
# Энд ЗӨВХӨН жишээ утга байна. Жинхэнэ түлхүүрийг энд бүү бич.

# Project URL — төгсгөлд нь /rest/v1/ бүү нэм
SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key — "sb_publishable_" гэж эхэлнэ. "sb_secret_" түлхүүрийг бүү ашигла.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
